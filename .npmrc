# Waiting period, in days, before npm 11+ resolves a newly published version.
# Zero means no waiting period. Keep this equal to coolingOffDays in
# security/dependency-policy.json; a test enforces that.
min-release-age=0

# Keep dependency lifecycle scripts disabled; the Motif-owned preparation
# helper runs only its fixed, hash-verified binary step after policy validation.
# This is supported by the npm versions used by both maintainer and CI tooling.
ignore-scripts=true
